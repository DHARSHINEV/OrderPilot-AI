# OrderPilot AI — Environment Configuration Example
# Copy this file to .env.local to enable optional live cloud LLM integrations.
# The application works 100% out of the box in Demo Mode without any API keys.

# Port configuration (default: 3000 or 3005)
PORT=3005

# Optional: Google Gemini API Key for AI-orchestrated parsing
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: OpenAI API Key (gpt-4o-mini structured outputs)
# Get key from: https://platform.openai.com/
OPENAI_API_KEY=

# Optional: Anthropic API Key
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Active AI Provider: "demo" (default deterministic) | "gemini" | "openai" | "anthropic"
AI_PROVIDER=demo
